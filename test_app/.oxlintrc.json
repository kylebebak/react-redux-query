{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": ["error", { "args": "none", "ignoreRestSiblings": true }],
    "react/purity": "off"
  },
  "env": {
    "builtin": true
  }
}